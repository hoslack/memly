rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify authentication and user ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Users collection ( strictly personal )
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Decks collection:
    // - Anyone accessing the app can read & revise any saved deck
    // - Anyone can create a valid deck
    // - Only the creator (owner) can update or delete their deck
    match /decks/{deckId} {
      allow read: if true;
      allow create: if request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.questionCount is number;
      allow update, delete: if isResourceOwner();
    }

    // Questions collection:
    // - Anyone accessing the app can read questions for any deck
    // - Anyone creating a deck can create its questions
    // - Only the deck creator can update or delete questions
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.deckId is string
        && request.resource.data.question is string;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/decks/$(resource.data.deckId)).data.userId == request.auth.uid
      );
    }

    // Study Sessions collection ( strictly personal per student )
    match /studySessions/{sessionId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }

    // User Question Progress collection ( strictly personal per student )
    match /userQuestionProgress/{progressId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }
  }
}
