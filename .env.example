# ==============================================================================
# Server-Side Gemini AI Configuration (PRIMARY - NEVER expose to browser)
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ==============================================================================
# Server-Side OpenRouter AI Configuration (FALLBACK - NEVER expose to browser)
# ==============================================================================
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Exam Revision App"

# ==============================================================================
# Firebase Client SDK Configuration (Used by browser for Auth & Firestore/Storage)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# ==============================================================================
# Firebase Admin SDK Configuration (Optional server-side token verification & DB)
# ==============================================================================
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
